{
	admin off
	auto_https off
}

# TLS termina no Traefik do EasyPanel; aqui só roteia como o gateway oficial do Supabase.
:8000 {
	handle_path /auth/v1/* {
		reverse_proxy ads-auth:9999
	}
	handle_path /rest/v1/* {
		reverse_proxy ads-rest:3000
	}
	handle_path /storage/v1/* {
		reverse_proxy ads-storage:5000
	}
	# Modelos de e-mail em pt-BR que o Auth busca ao enviar (GOTRUE_MAILER_TEMPLATES_*).
	handle_path /email-templates/* {
		root * /srv/email-templates
		file_server
	}
	respond 404
}
