# Variáveis exemplificativas. Criar valores apenas nos gerenciadores de secrets.
# Nunca commitar .env com valores reais. Somente variáveis NEXT_PUBLIC_* chegam ao navegador.

# Origem pública (sem caminho) e subcaminho onde o app é servido. Ambos entram no build.
NEXT_PUBLIC_APP_URL=https://gerevendas.com.br
NEXT_PUBLIC_BASE_PATH=/ads

# Supabase. Sem URL + anon key o app roda em MODO DEMONSTRAÇÃO (dados só no navegador).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: só em jobs de servidor; nunca no frontend. Não usada na fase 1.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
ENCRYPTION_KEY_REFERENCE=

# IA (fase 2: estratégia e criativos)
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# low | medium | high | xhigh | max | auto (custo cresce com a qualidade)
OPENAI_IMAGE_QUALITY=medium
# Teto de tokens de texto por empresa/mês
AI_MONTHLY_TOKEN_CAP=2000000

# ElevenLabs: narração e avatar em vídeo (ADR 0008). Vídeo pela API exige plano Pro.
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# voice_id das vozes pt-BR, separados por vírgula
ELEVENLABS_VOICE_IDS=

# Meta — BM única da GereVendas (ADR 0005). Guia: docs/META_OPERADOR.md
# Modo real exige META_MODE=real + FEATURE_FLAG_ACCOUNT_CREATION=true + as variáveis da BM.
META_MODE=mock
META_APP_ID=
META_APP_SECRET=
META_BUSINESS_ID=
# Token do System User da BM: só no servidor, nunca commitar.
META_SYSTEM_USER_TOKEN=
# Fuso das contas criadas pela API (ID numérico da Meta). Opcional.
META_AD_ACCOUNT_TIMEZONE_ID=
META_POOL_MIN_AVAILABLE=2

# Cobrança SaaS (fase posterior)
BILLING_PROVIDER=mock
BILLING_API_KEY=
BILLING_WEBHOOK_SECRET=

TRIGGER_SECRET_KEY=
SENTRY_DSN=

FEATURE_FLAG_WHATSAPP_ADS=false
FEATURE_FLAG_REAL_PUBLISHING=false
FEATURE_FLAG_ACCOUNT_CREATION=false
FEATURE_FLAG_PILOT_MODE=true
# Kill switch global: bloqueia qualquer integração externa quando true.
FEATURE_FLAG_KILL_SWITCH=false
